# ---------------------------------------------------------------------------
# Rubik's Cube Race - environment template. Copy to .env and fill in.
# The key is read by the backend only; it is never sent to the browser.
# ---------------------------------------------------------------------------

# "mock" (or empty) = offline simulation, no network calls, no cost.
# Put a real key (sk-or-v1-...) here for the live OpenRouter benchmark.
OPENROUTER_API_KEY=mock

# Shown on-screen during the whole demo (required by the assignment).
STUDENT_NAME=Your Name
STUDENT_ROLL=Roll No. 00-0000

# Experiment rules - identical for every model.
MAX_MOVES=20
REQUEST_TIMEOUT_S=180
MAX_RETRIES=1
MAX_INVALID_OUTPUTS=5
TRIAL_TIME_LIMIT_S=900
RECENT_MOVES_WINDOW=6

# Frontier LLM reasoning effort sent via OpenRouter (low|medium|high, empty = off).
OPUS_REASONING_EFFORT=medium

# Override model IDs if OpenRouter renames them.
MODEL_JEV=typesafe/jev-1.13
MODEL_LUNA=openai/gpt-6-luna-decisions
MODEL_CLEF=cloudflare/clef
MODEL_OPUS=anthropic/claude-opus-5.5

# Mock mode only: multiply simulated latencies (0.1 = 10x faster demo).
MOCK_LATENCY_SCALE=1.0

# Web UI: seconds each finished puzzle stays on screen before the next one starts.
PUZZLE_PAUSE_S=4

OPENROUTER_BASE_URL=https://openrouter.ai
APP_URL=http://localhost:8000

# --- OpenRouter API budget (hard limits, enforced in the backend) ---------------------
# Every actual request counts (failures and retries too). Counters persist in
# state/api_budget.json and are never reset by restarting the app.
MAX_TOTAL_API_CALLS=65
MAX_CLAUDE_CALLS=5
MAX_DECISION_CALLS_PER_MODEL=20
KEY_HARD_LIMIT=100
# Replay cached responses at their original live latency (for re-recording a demo).
CACHE_REPLAY_REALTIME=0

# --- Ollama (local open models; free, cached, no budget) -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_JEV=gemma3:1b
OLLAMA_MODEL_LUNA=llama3.2:1b
OLLAMA_MODEL_CLEF=qwen2.5:1.5b
OLLAMA_MODEL_OPUS=qwen3:4b
